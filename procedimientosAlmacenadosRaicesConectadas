-- 1. Registro seguro de reservas validando la existencia del cliente
CREATE OR ALTER PROCEDURE sp_InsertarReserva
    @p_correo_cliente VARCHAR(255),
    @p_id_paquete BIGINT,
    @p_cantidad_personas VARCHAR(255)
AS
BEGIN
    DECLARE @v_id_cliente BIGINT;

    -- Buscar el ID del cliente mediante su correo
    SELECT @v_id_cliente = id FROM clientes WHERE correo = @p_correo_cliente;

    -- Validar si el cliente existe antes de insertar la reserva
    IF @v_id_cliente IS NOT NULL
    BEGIN
        INSERT INTO reservas (fecha_reserva, id_cliente, id_paquete_turistico, cantidad_Personas)
        VALUES (GETDATE(), @v_id_cliente, @p_id_paquete, @p_cantidad_personas);
        PRINT 'Transacción exitosa: Reserva registrada en el sistema.';
    END
    ELSE
    BEGIN
        PRINT 'Error de integridad: El cliente no se encuentra registrado.';
    END
END;
GO

-- 2. Consulta de la oferta turística filtrada por destino patrimonial
CREATE OR ALTER PROCEDURE sp_ConsultarPaquetesPorDestino
    @p_id_destino BIGINT
AS
BEGIN
    SELECT 
        d.nombre AS Destino_Patrimonial, 
        p.nombre AS Nombre_Paquete, 
        p.precio AS Precio_Total, 
        p.descripcion AS Detalles_Incluidos
    FROM destinos d
    INNER JOIN paquete_destinos pd ON d.id = pd.id_destino
    INNER JOIN paquetes_turisticos p ON pd.id_paquete = p.id
    WHERE d.id = @p_id_destino;
END;
GO

-- 3. Autenticación de usuarios para acceso al sistema
CREATE OR ALTER PROCEDURE sp_ValidarAccesoCliente
    @p_correo VARCHAR(255),
    @p_password VARCHAR(255)
AS
BEGIN
    -- Retorna los datos del perfil si las credenciales coinciden
    SELECT id, nombre, telefono 
    FROM clientes 
    WHERE correo = @p_correo AND password = @p_password;
END;
GO
